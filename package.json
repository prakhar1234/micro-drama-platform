{
  "name": "micro-drama-platform",
  "version": "1.0.0",
  "description": "A micro drama platform for adults who love anime and dramatics — short-form, emotionally intense episodic content.",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build --workspace=frontend",
    "start": "node backend/src/server.js"
  },
  "keywords": [
    "micro-drama",
    "anime",
    "streaming",
    "short-form",
    "episodic"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
